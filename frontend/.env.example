# VITE ENV — frontend
# Copy to .env and adjust as needed.

# Mock mode (default): true = demo data, no backend needed.
# Set to false to call the real Express backend.
VITE_USE_MOCK=true

# Real backend base URL (used when VITE_USE_MOCK=false).
# Member 3's backend defaults to http://localhost:5000 (see backend/.env.example).
VITE_API_URL=http://localhost:5000/api
