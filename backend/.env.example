PORT=5000
# Supabase project credentials (Dashboard → Project Settings → API)
# Accepts either key style:
#   New format:  sb_secret_...            (API Keys → Secret keys → Reveal)
#   Legacy:      eyJ... service_role JWT  (API Keys → Legacy keys)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_secret_key_here

# Browser origins allowed by CORS, comma-separated.
CORS_ORIGIN=http://localhost:5173
DETECTION_ENGINE_URL=http://localhost:8000
MOCK_DETECTION=true

# Nova AI (document analysis) — OpenAI-compatible chat completions.
# Key format: nova_sk_... (from your Nova-route project dashboard).
# If the default host does not resolve, set NOVA_API_BASE_URL to the
# deployment URL your key was issued for.
NOVA_API_KEY=nova_sk_your_key_here
NOVA_API_BASE_URL=https://api.nova.ai
# Optional overrides:
# NOVA_API_MODEL=          (falls back to the project default model)
# NOVA_API_TIMEOUT_MS=60000
